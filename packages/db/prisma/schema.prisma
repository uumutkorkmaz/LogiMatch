// LogiMatch Prisma şeması — docs/DOMAIN.md ile birebir.
//
// Prisma'nın desteklemediği parçalar migration SQL'inde elle eklenir:
//  - geography(Point,4326) kolonları: lat/lng kolonlarından GENERATED ALWAYS ... STORED
//  - Shipment çakışma kısıtları: EXCLUDE USING gist (btree_gist)
//  - partial unique index'ler, append-only trigger'lar, GIST/trigram index'ler
// Tüm zamanlar timestamptz (UTC), tüm para tutarları Decimal(14,2).

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, btree_gist, pg_trgm, citext]
}

