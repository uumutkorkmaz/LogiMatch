# ---------------------------------------------------------------------------
# LogiMatch — örnek ortam değişkenleri. `.env` olarak kopyalayın; gerçek sırları
# ASLA repoya koymayın.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=UTC

# --- Veritabanı (docker compose: postgis/postgis:16) ---
DATABASE_URL=postgresql://logimatch:logimatch@localhost:5432/logimatch?schema=public
DATABASE_URL_TEST=postgresql://logimatch:logimatch@localhost:5432/logimatch_test?schema=public

# --- Redis (cache + BullMQ + rate limit + bildirim dedup) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# JWT — üretimde en az 32 byte rastgele değer kullanın (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limit (istek / dakika)
RATE_LIMIT_AUTH=5
RATE_LIMIT_SEARCH=60
RATE_LIMIT_WRITE=30

# Idempotency-Key kayıtlarının saklanma süresi (saat)
IDEMPOTENCY_TTL_HOURS=24

# --- Dosya depolama (MVP: yerel disk; sonra S3 uyumlu) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_MB=10

# --- E-posta (dev: MailHog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LogiMatch <no-reply@logimatch.test>"

# --- Harici sağlayıcılar (MVP'de hepsi mock) ---
GEOCODING_PROVIDER=mock
ROUTING_PROVIDER=mock
# OSRM kullanılırsa: http://localhost:5000
OSRM_BASE_URL=
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
TAX_ID_VERIFIER=mock

# --- Worker ---
WORKER_CONCURRENCY_MATCHING=4
WORKER_CONCURRENCY_NOTIFICATIONS=8

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Harita tile'ları (API key gerektirmeyen açık kaynak stil)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
